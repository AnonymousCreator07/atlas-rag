# OpenAI is used for answer generation. Set this to enable chat responses.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# Embeddings: local (default, runs on CPU) or openai.
EMBEDDING_PROVIDER=local
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Local persistent vector store and retrieval behavior.
CHROMA_PATH=.data/chroma
CHROMA_COLLECTION=atlas_documents
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=5
MAX_CONTEXT_CHARS=12000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:8000
