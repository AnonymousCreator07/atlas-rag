# OpenAI is used for answer generation and optional agentic/grounding checks.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# Embeddings: local (default, runs on CPU) or openai.
EMBEDDING_PROVIDER=local
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Local persistent stores.
CHROMA_PATH=.data/chroma
CHROMA_COLLECTION=atlas_documents
MEMORY_PATH=.data/memory.sqlite3

# Chunking and retrieval.
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=5
RETRIEVAL_CANDIDATES=20
MAX_CONTEXT_CHARS=12000

# Cross-encoder reranking.
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Conversational memory.
MEMORY_ENABLED=true
MEMORY_MAX_TURNS=8

# Grounding verification. Set true for an additional OpenAI verification call.
GROUNDING_CHECK_ENABLED=false

# Bounded agentic retrieval/query reformulation.
AGENTIC_RAG_ENABLED=true
AGENTIC_MIN_RETRIEVAL_SCORE=0.25

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:8000
